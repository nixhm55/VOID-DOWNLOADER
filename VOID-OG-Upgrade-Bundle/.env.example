# VOID Frontend & Local Gateway Environment Configuration
# Copy to .env.local for local development. Never commit private keys or secrets.

# Existing Frontend Optional Keys
VITE_JAMENDO_CLIENT_ID=
VITE_LOSSLESS_API_URLS=

# Backend / Gateway OG Lossless Configuration (Server-Side Only — Never prefix secrets with VITE_)
OG_DEFAULT_TERRITORY=IN
OG_REQUIRE_COMMERCIAL_RIGHTS=true
OG_ENABLE_INTERNET_ARCHIVE=true
OG_ENABLE_WIKIMEDIA_COMMONS=true

JAMENDO_CLIENT_ID=
