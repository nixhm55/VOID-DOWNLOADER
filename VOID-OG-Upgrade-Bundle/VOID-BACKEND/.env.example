# ═══════════════════════════════════════════════════════════════════════════
# VOID BACKEND & OG GLOBAL LOSSLESS MUSIC ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
PORT=4000

# ───────────────────────────────────────────────────────────────────────────
# 1. EXISTING VOID QUALITY SECTIONS (HIGH / VERY HIGH / LOSSLESS) — PRESERVED
# ───────────────────────────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
APPLE_MUSIC_DEVELOPER_TOKEN=

# ───────────────────────────────────────────────────────────────────────────
# 2. OG SECTION — GENERAL & TERRITORY CONFIGURATION
# ───────────────────────────────────────────────────────────────────────────
OG_DEFAULT_TERRITORY=IN
OG_REQUIRE_COMMERCIAL_RIGHTS=true

# ───────────────────────────────────────────────────────────────────────────
# 3. OG CATEGORY 1 — LIVE & VERIFIED RIGHTS-CLEARED PROVIDERS (ACTIVE BY DEFAULT)
# ───────────────────────────────────────────────────────────────────────────
# Internet Archive (Rights-Cleared Public Domain / CC0 / CC-BY / CC-BY-SA Original FLAC/WAV/ALAC/AIFF)
OG_ENABLE_INTERNET_ARCHIVE=true
INTERNET_ARCHIVE_ACCESS_KEY=
INTERNET_ARCHIVE_SECRET_KEY=

# Wikimedia Commons (Rights-Cleared CC0 / Public Domain / CC-BY / CC-BY-SA Native FLAC & WAV)
OG_ENABLE_WIKIMEDIA_COMMONS=true
OG_WIKIMEDIA_USER_AGENT="VoidMusicPlayer-OG/1.0 (https://voidmusic.app; og-lossless@voidmusic.app)"

# ───────────────────────────────────────────────────────────────────────────
# 4. OG SELF-SERVICE INDEPENDENT FLAC CATALOGUE — JAMENDO API v3.0
#    Official endpoint: https://api.jamendo.com/v3.0/tracks/?audioformat=flac
#    Note: Free Jamendo API keys are limited to non-commercial use (Clause 3.3).
#    Set JAMENDO_COMMERCIAL_LICENSE_VERIFIED=true only when commercial streaming rights are active.
# ───────────────────────────────────────────────────────────────────────────
JAMENDO_CLIENT_ID=
JAMENDO_COMMERCIAL_LICENSE_VERIFIED=false

# ───────────────────────────────────────────────────────────────────────────
# 5. OG COMMERCIAL B2B LOSSLESS STREAMING INFRASTRUCTURE PROVIDERS
# ───────────────────────────────────────────────────────────────────────────
# MassiveMusic / 7digital (2-legged OAuth 1.0 + B2B HD FLAC Agreement for 16-bit & 24-bit FLAC)
MASSIVEMUSIC_CLIENT_ID=
MASSIVEMUSIC_CLIENT_SECRET=
MASSIVEMUSIC_HD_FLAC_ENABLED=false
MASSIVEMUSIC_IN_TERRITORY_CLEARED=false

# Tuned Global B2B Streaming API (16-bit & 24-bit HD FLAC, active in India)
TUNED_GLOBAL_API_KEY=
TUNED_GLOBAL_STORE_ID=
TUNED_GLOBAL_BASE_URL=https://api.tunedglobal.com
TUNED_GLOBAL_IN_TERRITORY_CLEARED=false

# AudioSocket MaaS v5 Lossless API (FLAC / WAV streaming & downloads)
AUDIOSOCKET_API_TOKEN=
AUDIOSOCKET_COMMERCIAL_LICENSE=false

# Qobuz Partner API v0.2 (Requires partner approval via api@qobuz.com + India territory clearance)
QOBUZ_CLIENT_ID=
QOBUZ_CLIENT_SECRET=
QOBUZ_USER_AUTH_TOKEN=
QOBUZ_COMMERCIAL_B2B_LICENSE=false
QOBUZ_IN_TERRITORY_CLEARED=false

# TIDAL Official API v2 (CRITICAL: Disabled for shared multi-provider OG playback unless written
# authorization from TIDAL permitting multi-provider content mixing & IN territory rights is obtained)
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
TIDAL_OG_WRITTEN_AUTHORIZATION=false
TIDAL_IN_TERRITORY_CLEARED=false

# ───────────────────────────────────────────────────────────────────────────
# 6. OG GLOBAL DISTRIBUTORS (DDEX ERN 4.3 / SFTP / S3 MASTER DELIVERY)
# ───────────────────────────────────────────────────────────────────────────
BELIEVE_DDEX_FEED_URL=
BELIEVE_PARTNER_API_KEY=
BELIEVE_COMMERCIAL_DSP_CONTRACT=false

FUGA_API_URL=
FUGA_API_TOKEN=
FUGA_COMMERCIAL_DSP_CONTRACT=false

THE_ORCHARD_API_KEY=
THE_ORCHARD_DDEX_ENDPOINT=
THE_ORCHARD_COMMERCIAL_DSP_CONTRACT=false

REVELATOR_API_BEARER_TOKEN=
REVELATOR_COMMERCIAL_DSP_CONTRACT=false

# ───────────────────────────────────────────────────────────────────────────
# 7. OG INDIAN REGIONAL MUSIC LABELS & COLLECTIVE LICENSING (MALAYALAM, TAMIL, TELUGU, HINDI, KANNADA, PUNJABI, BENGALI)
# ───────────────────────────────────────────────────────────────────────────
# Mandatory Indian Publishing Interactive Streaming (INTR) clearance flag:
IPRS_INDIA_INTR_LICENSE_ACTIVE=false

# Phonographic Digital Limited (PDL India — 1,300+ Indian labels collective digital licensing)
PDL_INDIA_PARTNER_KEY=
PDL_INDIA_FEED_URL=

# Saregama India Ltd. (150,000+ Hindi, Malayalam, Tamil, Telugu, Bengali, Carnatic, Hindustani masters)
SAREGAMA_PARTNER_KEY=
SAREGAMA_MASTER_FEED_URL=

# Times Music / Junglee Music
TIMES_MUSIC_PARTNER_KEY=
TIMES_MUSIC_MASTER_FEED_URL=

# Muzik247 (Malayalam & Tamil cinema lossless masters)
MUZIK247_PARTNER_KEY=
MUZIK247_MASTER_FEED_URL=

# Think Music (Tamil & Malayalam cinema lossless masters via Believe India)
THINK_MUSIC_PARTNER_KEY=
THINK_MUSIC_MASTER_FEED_URL=

# Divo / Warner Music India (Tamil, Kannada, Malayalam, Telugu lossless masters)
DIVO_PARTNER_KEY=
DIVO_MASTER_FEED_URL=
